{
  "name": "@ismail-elkorchi/html-parser",
  "version": "0.1.1",
  "description": "HTML parser with bounded text extraction, fragment parsing, and structural traversal.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ismail-elkorchi/html-parser.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "packageManager": "npm@11.10.0",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "main": "./dist/mod.js",
  "types": "./dist/mod.d.ts",
  "exports": {
    ".": {
      "types": "./dist/mod.d.ts",
      "import": "./dist/mod.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/mod.d.ts",
    "dist/public/**/*.d.ts",
    "docs/*.md",
    "README.md",
    "SECURITY.md",
    "SUPPORT.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "fmt": "eslint . --fix --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "character-references:generate": "node scripts/generate/generate-named-character-references.mjs",
    "character-references:check": "node scripts/generate/generate-named-character-references.mjs --check",
    "character-references:refresh": "node scripts/generate/refresh-named-character-references.mjs",
    "build": "node scripts/build/clean-output.mjs && tsc -p tsconfig.build.json && node scripts/build/prune-private-declarations.mjs",
    "prepare": "npm run build",
    "test": "npm run test:behavior && npm run test:runtime && npm run qualification:wpt",
    "test:behavior": "npm run build && node scripts/test/run-node-tests.mjs test/behavior && node scripts/eval/write-stub-reports.mjs",
    "test:runtime:compile": "node scripts/test/compile-runtime-tests.mjs",
    "test:runtime": "npm run test:runtime:compile && node scripts/test/run-node-tests.mjs tmp/test-runtime/test/engine",
    "test:architecture": "node scripts/quality/check-architecture.mjs",
    "test:conformance": "npm run build && npm run test:runtime:compile && node scripts/conformance/run-all.mjs",
    "test:encoding": "npm run build && node scripts/conformance/run-encoding-fixtures.mjs",
    "test:tokenizer": "npm run build && npm run test:runtime:compile && node scripts/conformance/run-tokenizer-fixtures.mjs",
    "test:tree": "npm run build && node scripts/conformance/run-tree-fixtures.mjs",
    "test:serializer": "npm run build && node scripts/conformance/run-serializer-fixtures.mjs",
    "test:holdout": "npm run build && npm run test:runtime:compile && node scripts/conformance/run-holdout-fixtures.mjs",
    "test:engine:unit": "npm run test:runtime:compile && node scripts/test/run-node-tests.mjs tmp/test-runtime/test/engine",
    "test:engine:character-references": "npm run test:runtime:compile && node scripts/test/run-node-tests.mjs tmp/test-runtime/test/engine/character-references",
    "test:engine:tokenizer": "npm run test:runtime:compile && node scripts/test/run-node-tests.mjs tmp/test-runtime/test/engine/tokenizer",
    "test:engine:tree": "npm run test:runtime:compile && node scripts/test/run-node-tests.mjs tmp/test-runtime/test/engine/tree",
    "test:engine:tree-builder:conformance": "npm run build && node scripts/conformance/run-engine-tree-builder-fixtures.mjs",
    "test:types": "tsc --noEmit -p tsconfig.type-tests.json",
    "test:browser-diff": "npm run build && node scripts/oracles/run-browser-diff.mjs",
    "test:browser-diff:engine-formatting": "npm run build && node scripts/oracles/run-engine-formatting-browser-diff.mjs",
    "test:browser-diff:engine-contextual": "npm run build && node scripts/oracles/run-engine-contextual-browser-diff.mjs",
    "test:browser-diff:engine-foreign-fragment": "npm run build && node scripts/oracles/run-engine-foreign-fragment-browser-diff.mjs",
    "test:browser-diff:serialization": "npm run build && node scripts/oracles/run-public-serialization-browser-diff.mjs",
    "test:fuzz": "npm run build && node scripts/fuzz/run-fuzz.mjs",
    "test:bench:hard-budgets": "npm run build && node --expose-gc scripts/bench/run-hard-budget-evidence.mjs",
    "test:bench:text-extraction": "npm run build && node --expose-gc scripts/bench/run-text-extraction-evidence.mjs",
    "test:bench:character-references": "npm run test:runtime:compile && node --expose-gc scripts/bench/run-character-reference-evidence.mjs",
    "test:bench:engine-tokenizer": "npm run build && node --expose-gc scripts/bench/run-engine-tokenizer-evidence.mjs",
    "test:bench:engine-tree": "npm run build && node --expose-gc scripts/bench/run-engine-tree-evidence.mjs",
    "test:bench:engine-tree-builder": "npm run build && node --expose-gc scripts/bench/run-engine-tree-builder-evidence.mjs",
    "test:bench:engine-formatting": "npm run build && node --expose-gc scripts/bench/run-engine-formatting-evidence.mjs",
    "test:bench:independent-product": "npm run build && node --expose-gc scripts/bench/run-independent-product-evidence.mjs",
    "qualification:wpt": "npm run build && node scripts/conformance/run-engine-tree-builder-fixtures.mjs --qualification",
    "qualification:serialization": "npm run build && node scripts/qualification/run-public-serialization.mjs && node scripts/qualification/run-public-serialization-roundtrip.mjs",
    "qualification:runtime": "npm run build && node scripts/qualification/run-cross-runtime.mjs",
    "qualification:performance": "npm run build && node scripts/qualification/run-performance.mjs",
    "qualification:supply-chain": "npm run build && node scripts/qualification/run-supply-chain.mjs",
    "examples:run": "npm run build && node examples/run-all.mjs",
    "smoke:node": "npm run build && node scripts/smoke/control.mjs --runtime=node --report=reports/smoke-node.json",
    "smoke:deno": "deno run --allow-read --allow-write=reports --allow-env scripts/smoke/control.mjs --runtime=deno --report=reports/smoke-deno.json",
    "smoke:bun": "bun run scripts/smoke/control.mjs --runtime=bun --report=reports/smoke-bun.json",
    "smoke:browser": "npm run build && node scripts/smoke/browser-smoke.mjs --report=reports/smoke-browser.json",
    "smoke:all": "npm run smoke:node && npm run smoke:deno && npm run smoke:bun",
    "check:fast": "npm run character-references:check && npm run lint && npm run typecheck && npm run typecheck:jsr && npm run test:architecture && npm run test:behavior && npm run test:runtime && npm run test:engine:tree-builder:conformance && npm run test:types && npm run test:public-surface && npm run test:packed-types && npm run docs:check && npm run docs:snippets && npm run docs:required && npm run docs:quality:jsr && npm run examples:run",
    "typecheck:jsr": "deno check jsr/mod.ts",
    "docs:lint:jsr": "deno doc --lint jsr/mod.ts",
    "docs:test:jsr": "deno test --doc --no-check jsr/mod.ts",
    "deps:freshness": "npm outdated || true",
    "pack:check": "node scripts/eval/pack-check.mjs",
    "mutation:pilot": "npm run build && npm run test:runtime:compile && node scripts/mutation/run-pilot.mjs --config=scripts/mutation/pilot-config.json --out=reports/mutation-pilot.json",
    "eval:ci": "node scripts/eval/run-eval.mjs --profile=ci",
    "eval:release": "node scripts/eval/run-eval.mjs --profile=release",
    "docs:check": "node scripts/eval/check-docs.mjs",
    "docs:snippets": "npm run build && node scripts/eval/check-doc-snippets.mjs",
    "docs:required": "node scripts/quality/doc-required.mjs",
    "docs:quality:jsr": "node scripts/quality/doc-jsr-quality.mjs",
    "test:public-surface": "npm run build && node scripts/quality/check-public-surface.mjs",
    "test:packed-types": "node scripts/quality/check-packed-types.mjs",
    "release:notes:dry-run": "node scripts/release/render-notes.mjs --dry-run",
    "changelog:update:dry-run": "node scripts/release/update-changelog.mjs --dry-run",
    "wpt-tree:refresh": "node scripts/conformance/refresh-wpt-tree-fixtures.mjs",
    "wpt-serialization:refresh": "node scripts/conformance/refresh-wpt-serialization-fixtures.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "eslint": "10.7.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.0.2",
    "eslint-plugin-import-x": "4.17.1",
    "playwright": "1.61.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0"
  },
  "volta": {
    "node": "24.13.1"
  }
}
