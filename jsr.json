{
  "$schema": "https://jsr.io/schema/config-file.v1.json",
  "name": "@ismail-elkorchi/html-parser",
  "version": "0.1.1",
  "exports": {
    ".": "./jsr/mod.ts"
  },
  "publish": {
    "include": [
      "src/**/*.ts",
      "jsr/mod.ts",
      "docs/*.md",
      "README.md",
      "SECURITY.md",
      "SUPPORT.md",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ]
  },
  "exclude": [
    "dist/**",
    "node_modules/**",
    "reports/**",
    "tmp/**",
    "html-parser-*.tgz"
  ]
}
