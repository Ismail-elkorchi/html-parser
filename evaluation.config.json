{
  "version": 1,
  "profiles": {
    "ci": {
      "requireBrowserDiff": false,
      "requireDeno": true,
      "requireBun": true,
      "requireBrowserSmoke": true,
      "requireFuzzReport": false,
      "requireStreamReport": true,
      "requireAgentReport": true,
      "requireConformanceReports": true,
      "requirePackReport": true,
      "requireDocsReport": true,
      "requireBudgetsReport": true,
      "requirePerformanceQualification": false,
      "robustnessUsesFuzz": false,
      "weights": {
        "correctness": 70,
        "browserDiff": 0,
        "performance": 0,
        "robustness": 10,
        "agentFirst": 15,
        "packagingTrust": 5
      }
    },
    "release": {
      "requireBrowserDiff": true,
      "requireDeno": true,
      "requireBun": true,
      "requireBrowserSmoke": true,
      "requireFuzzReport": true,
      "requireStreamReport": true,
      "requireAgentReport": true,
      "requireConformanceReports": true,
      "requirePackReport": true,
      "requireDocsReport": true,
      "requireBudgetsReport": true,
      "requirePerformanceQualification": true,
      "robustnessUsesFuzz": true,
      "weights": {
        "correctness": 40,
        "browserDiff": 20,
        "performance": 15,
        "robustness": 10,
        "agentFirst": 10,
        "packagingTrust": 5
      }
    }
  },
  "thresholds": {
    "conformance": {
      "tokenizer": {
        "minPassRate": 1,
        "maxSkips": 0
      },
      "tree": {
        "minPassRate": 1,
        "maxSkips": 0
      },
      "encoding": {
        "minPassRate": 1,
        "maxSkips": 0
      },
      "serializer": {
        "minPassRate": 1,
        "maxSkips": 0
      }
    },
    "browserDiff": {
      "minAgreement": 0.999,
      "minEnginesPresent": 3,
      "minCases": 500,
      "minTagCoverage": 10,
      "requiredTags": [
        "tokenizer/entities",
        "adoption-agency",
        "tables/foster-parenting",
        "foreign-content (svg/mathml)",
        "templates",
        "optional-tags",
        "comments/doctype",
        "scripting-flag surface (document.write-like markup patterns as strings only)"
      ]
    },
    "determinism": {
      "requireNode": true,
      "requireDeno": true,
      "requireBun": true,
      "requireCrossRuntime": true
    },
    "budgets": {
      "requireBudgetsReport": true,
      "requireNoHangs": true,
      "requireStructuredBudgetErrors": true,
      "requireFuzzReport": true
    },
    "packaging": {
      "forbiddenPaths": [
        "vendor/",
        "test/",
        "codex-prompts/",
        "scripts/"
      ]
    }
  },
  "weights": {
    "correctness": 40,
    "browserDiff": 20,
    "performance": 15,
    "robustness": 10,
    "agentFirst": 10,
    "packagingTrust": 5
  },
  "scoring": {
    "passRateScoreShape": "fromThresholdToPerfect",
    "browserAgreementAggregation": "min",
    "performanceAggregation": "geometricMean"
  }
}
